# ==========================================
# THE SHREYASH FILES - ENVIRONMENT CONFIG
# ==========================================

# MongoDB Atlas / Database URI (GridFS and document storage)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shreyash_files?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=the-shreyash-files-classified-encryption-key-32-chars

# Google OAuth Credentials (for vintage Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Directorate Master Authority Email
ADMIN_EMAIL=imitsankit@gmail.com
ADMIN_MASTER_KEY=directorate-override-secret-passkey

# Google reCAPTCHA v3 (Optional bot prevention)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
